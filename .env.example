# Database
DATABASE_URL=postgresql+asyncpg://codeatlas:codeatlas_dev@localhost:5432/codeatlas
DATABASE_URL_SYNC=postgresql+psycopg2://codeatlas:codeatlas_dev@localhost:5432/codeatlas

# Redis
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=codeatlas

# Ollama (Local LLM)
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=codellama:7b

# GitHub App
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY_PATH=./apps/api/private-key.pem
GITHUB_WEBHOOK_SECRET=change-me-webhook-secret

# GitHub OAuth (for user login)
GITHUB_CLIENT_ID=Iv1.example
GITHUB_CLIENT_SECRET=example-secret

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=RS256
# Path to RSA private key PEM. Leave empty to fall back to HS256 with JWT_SECRET (dev only).
JWT_PRIVATE_KEY_PATH=
JWT_ACCESS_EXPIRY_MINUTES=30
JWT_REFRESH_EXPIRY_DAYS=30

# Next.js
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-nextauth-secret
NEXT_PUBLIC_API_URL=http://localhost:8000

# App
ENVIRONMENT=development
LOG_LEVEL=DEBUG
